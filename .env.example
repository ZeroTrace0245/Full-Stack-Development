# Local development uses Vite's proxy. Keep Atlas credentials in backend/.env.
VITE_API_URL=/api
VITE_SOCKET_URL=/

# Set these in Render's STATIC SITE environment for deployment:
# VITE_API_URL=https://YOUR-BACKEND.onrender.com/api
# VITE_SOCKET_URL=https://YOUR-BACKEND.onrender.com
# VITE_ values are public and must never contain database credentials or secrets.
