# Copy this file to backend/.env and replace the placeholder values.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRE=7d
PORT=5000
SOCKET_IO_CORS=http://localhost:54995

# MongoDB Atlas connection string. If omitted, the app remains local-only.
# URI-encode special characters in the database password.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?appName=NovaSync
MONGODB_DB_NAME=novasync
SYNC_INTERVAL_MS=15000
SYNC_RETRY_MS=15000
