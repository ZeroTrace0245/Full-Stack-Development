PORT=5000
FRONTEND_URL=http://localhost:54995
BACKEND_URL=http://localhost:5000
SOCKET_IO_CORS=http://localhost:54995
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRE=7d

# Milestone 2: true uses in-memory data and requires no database server.
# Milestone 3: set false and provide a running MongoDB connection below.
USE_MOCK_DATA=true
MONGODB_URI=mongodb://127.0.0.1:27017/novasync
